# Example docker-compose environment file
# Copy to fhirbackendauth.env and modify as necessary
# https://docs.docker.com/compose/env-file/
#
# Variables defined in this file are only available to containers,
# not for interpolation in docker-compose YAML files.

# Set by embedhw compose environment block (not secrets):
# SERVER_NAME=fhir-backend-auth.${BASE_DOMAIN}
# PREFERRED_URL_SCHEME=https
# REDIS_URL=redis://redis:6379/2

# Local standalone defaults (override in compose environment block):
SERVER_NAME=localhost:8000
PREFERRED_URL_SCHEME=http

# OAuth client credentials (Backend Services)
OAUTH_CLIENT_ID=
UPSTREAM_FHIR_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
OAUTH_SCOPES=system/Patient.read system/Observation.read

# Optional: client_assertion JWT lifetime in seconds (Epic max: 300)
# CLIENT_ASSERTION_EXPIRES_SECONDS=300

# Optional: override discovered token endpoint
# UPSTREAM_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# RSA key storage for private_key_jwt
JWK_KEY_DIR=/data/jwks

# Redis token cache (use DB /2 in embedhw to avoid collision with other services)
REDIS_URL=redis://redis:6379/2
TOKEN_CACHE_KEY=upstream:access_token
TOKEN_CACHE_BUFFER_SECONDS=60

LOG_LEVEL=INFO
